{
  "id": "F39",
  "group": "failing",
  "title": "PATCH /v1/orders/{id} to edit an order",
  "why": "Client tries to change the pickup date after placing.",
  "setup": [
    {
      "method": "POST",
      "path": "/v1/orders",
      "headers": {
        "Authorization": "Bearer {{key:live}}",
        "Content-Type": "application/json",
        "Idempotency-Key": "{{idem:setup}}"
      },
      "body": {
        "ref": "TEST-PO-1039",
        "pickup": {
          "address": "1200 Example Pkwy, Elk Grove Village, IL, 60007",
          "date": "{{date:+3}}"
        },
        "delivery": {
          "address": "2200 Sample Rd, Columbus, OH, 43217",
          "date": "{{date:+4}}"
        },
        "equipment": "tractor",
        "pieces": 12,
        "weight": {
          "value": 2400,
          "unit": "lbs"
        },
        "commodity": "Boxed machine parts"
      },
      "expect": {
        "status": 201
      },
      "save": {
        "id": "id"
      }
    }
  ],
  "request": {
    "method": "PATCH",
    "path": "/v1/orders/{{saved:id}}",
    "headers": {
      "Authorization": "Bearer {{key:live}}",
      "Content-Type": "application/json"
    },
    "body": {
      "pickup": {
        "address": "1200 Example Pkwy, Elk Grove Village, IL, 60007",
        "date": "{{date:+6}}"
      }
    }
  },
  "expect": {
    "status": 405,
    "content_type": "application/problem+json",
    "body": {
      "type": "about:blank",
      "title": "Method not allowed",
      "status": 405,
      "code": "method_not_allowed",
      "detail": "This path does not support that method."
    },
    "no_errors": true,
    "headers": {
      "Allow": "GET"
    }
  }
}
