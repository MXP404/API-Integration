{
  "id": "F25",
  "group": "failing",
  "title": "Unknown state code (ZZ)",
  "why": "Typo or placeholder in the client address book.",
  "request": {
    "method": "POST",
    "path": "/v1/orders",
    "headers": {
      "Authorization": "Bearer {{key:live}}",
      "Content-Type": "application/json",
      "Idempotency-Key": "{{idem}}"
    },
    "body": {
      "ref": "TEST-PO-1025",
      "pickup": {
        "address": "9 Placeholder Rd, Springfield, ZZ 62704",
        "date": "{{date:+3}}"
      },
      "delivery": {
        "address": "2200 Sample Rd, Columbus, OH, 43217",
        "date": "{{date:+4}}"
      },
      "equipment": "tractor",
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts"
    }
  },
  "expect": {
    "status": 201,
    "content_type": "application/json",
    "body": {
      "ref": "TEST-PO-1025",
      "status": "submitted",
      "pickup": {
        "address": "9 Placeholder Rd, Springfield, ZZ 62704",
        "date": "{{date:+3}}"
      },
      "delivery": {
        "address": "2200 Sample Rd, Columbus, OH, 43217",
        "date": "{{date:+4}}"
      },
      "equipment": "tractor",
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts",
      "loads": []
    },
    "body_match": {
      "id": "^REQ-[0-9]+$",
      "created_at": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "note": "Placed, by design: an unreadable state goes to review (contract InvalidOrder text says so). Nothing tells the client the address looked wrong."
}
