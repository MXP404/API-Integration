{
  "id": "V07",
  "group": "valid",
  "title": "Pickup address with no readable state goes to review, not refused",
  "why": "A site name with no state. The zone rule never refuses on a guess, so it is placed for a person to check.",
  "request": {
    "method": "POST",
    "path": "/v1/orders",
    "headers": {
      "Authorization": "Bearer {{key:live}}",
      "Content-Type": "application/json",
      "Idempotency-Key": "{{idem}}"
    },
    "body": {
      "ref": "TEST-PO-1007",
      "pickup": {
        "address": "Building 7, Gate B, Example Industrial Park",
        "date": "{{date:+3}}"
      },
      "delivery": {
        "address": "2200 Sample Rd, Columbus, OH, 43217",
        "date": "{{date:+4}}"
      },
      "equipment": "tractor",
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts"
    }
  },
  "expect": {
    "status": 201,
    "content_type": "application/json",
    "body": {
      "ref": "TEST-PO-1007",
      "status": "submitted",
      "pickup": {
        "address": "Building 7, Gate B, Example Industrial Park",
        "date": "{{date:+3}}"
      },
      "delivery": {
        "address": "2200 Sample Rd, Columbus, OH, 43217",
        "date": "{{date:+4}}"
      },
      "equipment": "tractor",
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts",
      "loads": []
    },
    "body_match": {
      "id": "^REQ-[0-9]+$",
      "created_at": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
