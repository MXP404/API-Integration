{
  "id": "V09",
  "group": "valid",
  "title": "Read an order back by id",
  "why": "After placing, the client checks its status.",
  "setup": [
    {
      "method": "POST",
      "path": "/v1/orders",
      "headers": {
        "Authorization": "Bearer {{key:live}}",
        "Content-Type": "application/json",
        "Idempotency-Key": "{{idem:setup}}"
      },
      "body": {
        "ref": "TEST-PO-1009",
        "pickup": {
          "address": "1200 Example Pkwy, Elk Grove Village, IL, 60007",
          "date": "{{date:+3}}"
        },
        "delivery": {
          "address": "2200 Sample Rd, Columbus, OH, 43217",
          "date": "{{date:+4}}"
        },
        "equipment": "tractor",
        "pieces": 12,
        "weight": {
          "value": 2400,
          "unit": "lbs"
        },
        "commodity": "Boxed machine parts"
      },
      "expect": {
        "status": 201
      },
      "save": {
        "id": "id"
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/v1/orders/{{saved:id}}",
    "headers": {
      "Authorization": "Bearer {{key:live}}"
    }
  },
  "expect": {
    "status": 200,
    "content_type": "application/json",
    "body": {
      "id": "{{saved:id}}",
      "ref": "TEST-PO-1009",
      "status": "submitted",
      "loads": []
    }
  }
}
