    "body": {
      "ref": "TEST-PO-1036",
      "pickup": {
        "address": "1200 Example Pkwy, Elk Grove Village, IL, 60007",
        "date": "{{date:+3}}"
      },
      "delivery": {
        "address": "2200 Sample Rd, Columbus, OH, 43217",
        "date": "{{date:+4}}"
      },
      "equipment": "tractor",
      "pieces": 14,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts"
    }
  },
  "expect": {
    "status": 409,
    "content_type": "application/problem+json",
    "body": {
