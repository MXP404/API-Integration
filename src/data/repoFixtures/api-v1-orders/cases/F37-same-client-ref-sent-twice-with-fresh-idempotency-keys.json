      "status": "submitted",
      "pickup": {
        "address": "1200 Example Pkwy, Elk Grove Village, IL, 60007",
        "date": "{{date:+3}}"
      },
      "delivery": {
        "address": "2200 Sample Rd, Columbus, OH, 43217",
        "date": "{{date:+4}}"
      },
      "equipment": "tractor",
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
