{
  "id": "F49",
  "group": "failing",
  "title": "Another client reads my order by id",
  "why": "Tenancy: a second client guesses REQ numbers.",
  "setup": [
    {
      "method": "POST",
      "path": "/v1/orders",
      "headers": {
        "Authorization": "Bearer {{key:live}}",
