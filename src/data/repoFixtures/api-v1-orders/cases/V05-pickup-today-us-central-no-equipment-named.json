{
  "id": "V05",
  "group": "valid",
  "title": "Pickup today (US Central), no equipment named",
  "why": "Same-day pickup is the earliest date allowed; equipment is optional.",
  "request": {
    "method": "POST",
    "path": "/v1/orders",
    "headers": {
      "Authorization": "Bearer {{key:live}}",
      "Content-Type": "application/json",
      "Idempotency-Key": "{{idem}}"
    },
    "body": {
      "ref": "TEST-PO-1005",
      "pickup": {
        "address": "640 Sample Ct, Des Moines, IA 50309",
        "date": "{{date:+0}}"
      },
      "delivery": {
        "address": "82 Example Loop, Minneapolis, MN, 55413",
        "date": "{{date:+1}}"
      },
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts"
    }
  },
  "expect": {
    "status": 201,
    "content_type": "application/json",
    "body": {
      "ref": "TEST-PO-1005",
      "status": "submitted",
      "pickup": {
        "address": "640 Sample Ct, Des Moines, IA 50309",
        "date": "{{date:+0}}"
      },
      "delivery": {
        "address": "82 Example Loop, Minneapolis, MN, 55413",
        "date": "{{date:+1}}"
      },
      "equipment": null,
      "pieces": 12,
      "weight": {
        "value": 2400,
        "unit": "lbs"
      },
      "commodity": "Boxed machine parts",
      "loads": []
    },
    "body_match": {
      "id": "^REQ-[0-9]+$",
      "created_at": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
